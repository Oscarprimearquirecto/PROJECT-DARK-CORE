import os
import math
import numpy as np
from typing import List, Tuple

# Forzar backend headless 'Agg' antes de importar pyplot para evitar errores de GUI en entornos móviles
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D

# Diccionario de traducción estándar de 1 a 3 letras (IUPAC)
AA_MAP = {
    'A': 'ALA', 'R': 'ARG', 'N': 'ASN', 'D': 'ASP', 'C': 'CYS',
    'E': 'GLU', 'Q': 'GLN', 'G': 'GLY', 'H': 'HIS', 'I': 'ILE',
    'L': 'LEU', 'K': 'LYS', 'M': 'MET', 'F': 'PHE', 'P': 'PRO',
    'S': 'SER', 'T': 'THR', 'W': 'TRP', 'Y': 'TYR', 'V': 'VAL'
}

def clean_sequence(seq: str) -> str:
    """Limpia la secuencia de entrada de espacios, saltos de línea y la convierte a mayúsculas."""
    return "".join(seq.split()).upper()

def generate_alpha_carbon_trajectory(sequence: str) -> List[Tuple[float, float, float]]:
    """
    Calcula la proyección helicoidal en R^3 para el esqueleto de Carbonos Alfa (C-alpha).
    Parámetros físicos basados en geometrías de hélices nativas:
    - Radio (r) = 2.3 Angstroms
    - Ascenso por residuo (delta_z) = 1.5 Angstroms
    - Ángulo de rotación por residuo = 100 grados (1.74533 radianes)
    """
    coordinates = []
    angular_step = math.radians(100.0) # 100 grados de giro por residuo
    r = 2.3                            # Radio en Ångströms
    delta_z = 1.5                      # Avance en Z por residuo en Ångströms
    
    for i in range(len(sequence)):
        theta = i * angular_step
        x = r * math.cos(theta)
        y = r * math.sin(theta)
        z = i * delta_z
        coordinates.append((x, y, z))
        
    return coordinates

def write_pdb_file(sequence: str, coords: List[Tuple[float, float, float]], output_path: str):
    """
    Escribe el archivo .pdb respetando estrictamente el formato de columnas fijas
    requerido por PyMOL, ChimeraX y visores basados en WebGL.
    """
    with open(output_path, 'w', encoding='utf-8') as pdb_file:
        pdb_file.write(f"HEADER    DARK-CORE V2.0 - NCORF PRELIMINARY STRUCTURAL MODEL\n")
        pdb_file.write(f"TITLE     MICROPROTEIN BACKBONE GENERATED IN LIGHTWEIGHT COMPUTE MODE\n")
        
        for i, aa in enumerate(sequence):
            atom_id = i + 1
            res_name = AA_MAP.get(aa, 'UNK') # 'UNK' para aminoácidos no estándar o errores de lectura
            chain_id = 'A'
            res_seq = i + 1
            x, y, z = coords[i]
            occupancy = 1.00
            b_factor = 20.00 # Factor B basal asignado de forma estándar
            element = 'C'
            
            # Formato estricto PDB de ancho de columnas fijas:
            # ATOM  (1-6) | Atom ID (7-11) | Atom Name (13-16) | Res Name (18-20) | Chain (22) | Res Seq (23-26)
            # X coord (31-38) | Y coord (39-46) | Z coord (47-54) | Occupancy (55-60) | B-factor (61-66) | Element (77-78)
            line = (
                f"ATOM  {atom_id:>5}  CA  {res_name:<3} {chain_id}{res_seq:>4}    "
                f"{x:8.3f}{y:8.3f}{z:8.3f}{occupancy:6.2f}{b_factor:6.2f}           "
                f"{element:>2}\n"
            )
            pdb_file.write(line)
            
        pdb_file.write("TER\n")
        pdb_file.write("END\n")

def render_structural_png(coords: List[Tuple[float, float, float]], output_path: str):
    """
    Genera un renderizado 3D de la topología del esqueleto y lo exporta a PNG.
    Ideal para validación rápida "Edge" en entornos móviles sin cargadores gráficos complejos.
    """
    pts = np.array(coords)
    
    fig = plt.figure(figsize=(8, 6))
    ax = fig.add_subplot(111, projection='3d')
    
    # Dibujar la traza del esqueleto (backbone)
    ax.plot(pts[:, 0], pts[:, 1], pts[:, 2], color='#1f77b4', linewidth=3, label='C-alpha Trace', alpha=0.8)
    # Resaltar la posición de los átomos individuales de Carbono Alfa
    ax.scatter(pts[:, 0], pts[:, 1], pts[:, 2], color='#d62728', s=40, edgecolors='black', label='CA Atoms')
    
    # Estilización del gráfico
    ax.set_title("PROJECT DARK-CORE // Esqueleto 3D Estimado", fontsize=12, fontweight='bold', pad=15)
    ax.set_xlabel("X (Å)", fontsize=10)
    ax.set_ylabel("Y (Å)", fontsize=10)
    ax.set_zlabel("Z (Å)", fontsize=10)
    ax.legend(loc='upper left')
    ax.grid(True, linestyle='--', alpha=0.5)
    
    # Ajustar límites de visualización dinámicos según el tamaño del péptido
    max_range = np.array([pts[:, 0].max()-pts[:, 0].min(), pts[:, 1].max()-pts[:, 1].min(), pts[:, 2].max()-pts[:, 2].min()]).max() / 2.0
    mid_x = (pts[:, 0].max()+pts[:, 0].min()) * 0.5
    mid_y = (pts[:, 1].max()+pts[:, 1].min()) * 0.5
    mid_z = (pts[:, 2].max()+pts[:, 2].min()) * 0.5
    ax.set_xlim(mid_x - max_range, mid_x + max_range)
    ax.set_ylim(mid_y - max_range, mid_y + max_range)
    ax.set_zlim(mid_z - max_range, mid_z + max_range)
    
    plt.tight_layout()
    plt.savefig(output_path, dpi=150)
    plt.close()

# Ejemplo de ejecución y prueba unitaria del módulo
if __name__ == "__main__":
    # Secuencia de prueba: Microproteína sintética ncORF de 40 residuos
    test_sequence = "MAKEDNIYFICRLCGSYVTAEDWERHMKSCGKNWKKRRPV"
    clean_seq = clean_sequence(test_sequence)
    
    print(f"[DARK-CORE] Inicializando generación geométrica para secuencia de {len(clean_seq)} residuos.")
    
    # 1. Calcular trayectoria matemática
    coordinates_3d = generate_alpha_carbon_trajectory(clean_seq)
    
    # 2. Exportar matriz a formato estándar PDB
    pdb_output = "dark_core_output.pdb"
    write_pdb_file(clean_seq, coordinates_3d, pdb_output)
    print(f"[✓] Archivo estructural PDB generado exitosamente: '{pdb_output}'")
    
    # 3. Renderizar vista previa estática PNG
    png_output = "dark_core_preview.png"
    render_structural_png(coordinates_3d, png_output)
    print(f"[✓] Vista previa de topología guardada exitosamente: '{png_output}'")
